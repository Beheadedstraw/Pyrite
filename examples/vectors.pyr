import vectors

def main():
    a = [3, 4]
    b = [10, 2]
    c = [1, 2, 3]
    d = [4, 5, 6]

    sum2 = vectors.add2(a, b)
    diff2 = vectors.sub2(a, b)
    scaled2 = vectors.scale2(a, 3)
    dot2 = vectors.dot2(a, b)
    len2 = vectors.length_sq2(a)
    sum3 = vectors.add3(c, d)
    cross = vectors.cross3(c, d)
    len3 = vectors.length_sq3(c)

    print(f"add2 = {sum2}")
    print(f"sub2 = {diff2}")
    print(f"scale2 = {scaled2}")
    print(f"dot2 = {dot2}")
    print(f"length_sq2 = {len2}")

    print(f"add3 = {sum3}")
    print(f"cross3 = {cross}")
    print(f"length_sq3 = {len3}")

    return dot2
