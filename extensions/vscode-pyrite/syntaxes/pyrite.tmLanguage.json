{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pyrite",
  "scopeName": "source.pyrite",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#definitions" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#parameters" },
    { "include": "#members" },
    { "include": "#calls" },
    { "include": "#variables" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pyrite",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.f.pyrite",
          "begin": "\\bf\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pyrite",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.pyrite",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#numbers" },
                { "include": "#decorators" },
                { "include": "#builtins" },
                { "include": "#types" },
                { "include": "#members" },
                { "include": "#calls" },
                { "include": "#variables" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.pyrite",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pyrite",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.pyrite",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pyrite",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.pyrite",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.pyrite",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pyrite",
          "match": "\\b(if|else|while|for|foreach|switch|case|default|try|except|raise|return|defer|async)\\b"
        },
        {
          "name": "keyword.declaration.pyrite",
          "match": "\\b(import|global|const|class|def|native)\\b"
        },
        {
          "name": "constant.language.boolean.pyrite",
          "match": "\\b(True|False|true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.pyrite",
          "match": "\\b(int|integer|float|double|string|str|bool|boolean|any|file|socket|sock|listener|server|serversocket|mux|mutex|dict|object|list\\s*\\[\\s*(int|any)\\s*\\])\\b"
        },
        {
          "name": "entity.name.type.class.pyrite",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.pyrite",
          "match": "\\b(print|routine|async|mux)\\s*(?=\\()"
        },
        {
          "name": "support.module.pyrite",
          "match": "\\b(file|net|http|regex|random|time|routines|strings|ints|floats|json|xml|vectors)\\b(?=\\.)"
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "name": "meta.import.pyrite",
          "match": "^\\s*(import)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.pyrite" },
            "2": { "name": "support.module.pyrite" }
          }
        },
        {
          "name": "meta.function.pyrite",
          "match": "^\\s*(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.pyrite" },
            "2": { "name": "entity.name.function.pyrite" }
          }
        },
        {
          "name": "meta.class.pyrite",
          "match": "^\\s*(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.class.pyrite" },
            "2": { "name": "entity.name.type.class.pyrite" }
          }
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.function.pyrite",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*:)"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "variable.other.property.pyrite",
          "match": "\\bself\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "0": { "name": "variable.other.property.pyrite" },
            "1": { "name": "variable.other.member.pyrite" }
          }
        },
        {
          "name": "variable.other.member.pyrite",
          "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*)\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.type.class.pyrite",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.method.pyrite",
          "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.pyrite",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.assignment.pyrite",
          "match": "^\\s*(?:const\\s+|global\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?::|=))",
          "captures": {
            "1": { "name": "variable.other.assignment.pyrite" }
          }
        },
        {
          "name": "variable.other.pyrite",
          "match": "\\b(?!if\\b|else\\b|while\\b|for\\b|foreach\\b|switch\\b|case\\b|default\\b|try\\b|except\\b|raise\\b|return\\b|async\\b|import\\b|global\\b|const\\b|class\\b|def\\b|native\\b|True\\b|False\\b|true\\b|false\\b|self\\b|int\\b|float\\b|string\\b|str\\b|bool\\b|any\\b|file\\b|socket\\b|listener\\b|mux\\b|dict\\b|object\\b)[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "variable.language.self.pyrite",
          "match": "\\bself\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pyrite",
          "match": "(==|!=|<=|>=|=|\\+|-|\\*|/|<|>|:)"
        }
      ]
    }
  }
}
